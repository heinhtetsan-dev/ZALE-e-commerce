NODE_ENV=development
PORT=4000
# Local dev DB: `npm run db:start` (embedded PostgreSQL on port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shoeshop
# Used by the integration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shoeshop_test

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
# Number of reverse proxies (load balancer/CDN) in front of the API; 0 when clients connect directly.
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:5173

# "stripe" (test keys required) or "mock" (local only, refused in production)
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Images live on cloud storage / CDN. Relative image keys are prefixed with this.
CDN_BASE_URL=https://cdn.example.com
# Optional S3-compatible storage for presigned admin uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Without S3, admin photo uploads are saved here on the API server (relative to backend/)
UPLOAD_DIR=uploads

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_SWEEP_INTERVAL_SECONDS=60
SHIPPING_FLAT_CENTS=800
FREE_SHIPPING_THRESHOLD_CENTS=10000
